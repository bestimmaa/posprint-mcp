# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Required. Bearer token checked on every /mcp request. Generate with: openssl rand -hex 32
POSPRINT_AUTH_TOKEN=

# Default printer URI (CUPS/IPP). Use an IP or a router-provided DNS name —
# .local (mDNS) hostnames do not resolve inside the container.
PRINTER_URI=ipp://192.168.1.50:631/printers/T88V

# Optional. Port the container listens on (also used for the docker-compose port mapping).
PORT=3000
